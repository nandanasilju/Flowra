# Copy to .env and fill in. Generate secrets with: npm run gen:keys

# Database. SQLite for local use. For production use Postgres (see README "Deploy").
DATABASE_URL="file:./dev.db"

# 32+ random characters; signs login session cookies.
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"

# 32 random bytes, base64. Master key for encrypting notes/transcripts (AES-256-GCM).
# KEEP IT SAFE: if you lose it, encrypted notes cannot be recovered. Required in production.
ENCRYPTION_KEY=""

# Google Gemini (server-side only). Leave empty to run offline: sample notes + keyword extractor still work.
GEMINI_API_KEY=""
# Flash-class model id. CONFIRM the current model id in Google AI Studio.
GEMINI_MODEL="gemini-3.8-flash"

# Public URL of the site (used in password-reset emails).
APP_URL="http://localhost:3000"

# Email (password reset) via Resend. Without these, reset links are printed to the server console in development.
RESEND_API_KEY=""
EMAIL_FROM="Flowra <no-reply@yourdomain.com>"

# Admins: comma-separated emails that can open /admin. Optional: create an admin account when seeding.
ADMIN_EMAILS=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Sample (fictional) doctor profiles for demos. Set to "false" in production once real doctors are added.
SHOW_SAMPLE_DOCTORS="true"
